    },
    "SRC-002:R013": {
      "actionable": true,
      "class": "requirement",
      "text": "AE host verification PASS \u043b\u0438\u0431\u043e \u044f\u0432\u043d\u043e UNVERIFIED."
    },
    "SRC-002:R014": {
      "actionable": true,
